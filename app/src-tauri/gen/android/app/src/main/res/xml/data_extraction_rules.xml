<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of CarryChat's leaves the phone in a backup or a move to a new
     phone (§10): its data is encrypted with a key that only this phone's
     Keystore holds, and neither would carry it. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
